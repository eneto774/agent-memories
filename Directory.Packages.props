<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspnetVersion>9.0.0</AspnetVersion>
    <EfcoreVersion>9.0.4</EfcoreVersion>
    <SkVersion>1.32.0</SkVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Semantic Kernel -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="$(SkVersion)" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="$(SkVersion)" />
    <!-- Auth -->
    <PackageVersion
      Include="Microsoft.AspNetCore.Authentication.JwtBearer"
      Version="$(AspnetVersion)"
    />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfcoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfcoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EfcoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- Qdrant -->
    <PackageVersion Include="Qdrant.Client" Version="1.15.1" />
    <!-- Email -->
    <PackageVersion Include="MailKit" Version="4.12.0" />
    <PackageVersion Include="MimeKit" Version="4.12.0" />
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.6.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Resilience -->
    <PackageVersion Include="Polly" Version="8.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.4.0" />
  </ItemGroup>
</Project>